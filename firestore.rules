rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user is an admin if there's a doc at admins/{their-uid}.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The family this user belongs to. Defaults to their own uid (solo family);
    // if they've joined another family, users/{uid}.familyId points to it.
    function myFamilyId() {
      return (request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId
        : (request.auth != null ? request.auth.uid : '');
    }

    // users/{uid}: the membership pointer; the owner reads/writes only their own.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Family invites: creator makes one; anyone signed in who has the code can
    // read it (the code is the secret) and mark it accepted when joining.
    match /familyInvites/{code} {
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow read, update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // Family data (profile + plans/memories/saved subcollections). Accessible to
    // the founder (uid == familyId) OR any member whose users doc points here.
    // {document=**} wildcard required to cover subcollections.
    match /families/{familyId}/{document=**} {
      allow read, write: if request.auth != null
        && (request.auth.uid == familyId || myFamilyId() == familyId);
    }

    // A merchant account is marked by a doc at merchants/{their-uid}.
    function isMerchant() {
      return request.auth != null
        && exists(/databases/$(database)/documents/merchants/$(request.auth.uid));
    }

    // Merchant profile: the owner reads/writes their own.
    match /merchants/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Places: any signed-in user can read. Admins write anything. A merchant may
    // create a place they own (only as 'pending' + not promoted) and edit its
    // descriptive fields — but NOT self-approve or self-promote (status,
    // promoted, promotedUntil are locked to admins).
    match /places/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        || (request.auth != null
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.promoted == false);
      allow update: if isAdmin()
        // The owner edits their own place (can't self-approve or self-promote).
        || (request.auth != null
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == resource.data.status
            && request.resource.data.promoted == resource.data.promoted
            && request.resource.data.get('promotedUntil', null) == resource.data.get('promotedUntil', null))
        // Claim an UNOWNED place: set ownerUid to self (status/promotion locked),
        // so a merchant adopts the canonical doc instead of forking a duplicate.
        || (request.auth != null
            && resource.data.get('ownerUid', null) == null
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == resource.data.status
            && request.resource.data.promoted == resource.data.promoted
            && request.resource.data.get('promotedUntil', null) == resource.data.get('promotedUntil', null));
      allow delete: if isAdmin();
    }

    // Promotion requests: a merchant logs a request for their place; admins manage.
    match /promotionRequests/{id} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Hot events / collabs: any signed-in user reads; only admins write.
    match /events/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Bookings: a customer creates/reads their own. The merchant who owns the
    // place can read + update (confirm / mark redeemed). Admins read all.
    match /bookings/{id} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || resource.data.get('familyId', '') == myFamilyId()
        || resource.data.get('placeOwnerUid', '') == request.auth.uid
        || isAdmin()
      );
      allow update: if isAdmin()
        || (request.auth != null && resource.data.get('placeOwnerUid', '') == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Voucher orders: a customer buys a voucher (creates/reads their own + the
    // family's). The merchant who owns the place reads + updates (mark redeemed).
    // Admins read all. Mirrors the bookings rules.
    match /voucherOrders/{id} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || resource.data.get('familyId', '') == myFamilyId()
        || resource.data.get('placeOwnerUid', '') == request.auth.uid
        || isAdmin()
      );
      allow update: if isAdmin()
        || (request.auth != null && resource.data.get('placeOwnerUid', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Marketing campaigns: any signed-in user can read (app may surface them);
    // only admins write.
    match /campaigns/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin allowlist: readable by the owner, managed only in the console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
