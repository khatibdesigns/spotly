rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user is an admin if there's a doc at admins/{their-uid}.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Each family can read/write its own profile AND all of its subcollections
    // (plans, memories, saved). The {document=**} wildcard is required —
    // a plain /families/{uid} match would NOT cover subcollections.
    match /families/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Curated places: any signed-in user can read; only admins can write.
    match /places/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Bookings & album orders: a user creates/reads their own; admins read all.
    match /bookings/{id} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Marketing campaigns: any signed-in user can read (app may surface them);
    // only admins write.
    match /campaigns/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin allowlist: readable by the owner, managed only in the console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
