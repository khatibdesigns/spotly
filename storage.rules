rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Family files (memory photos). Accessible to the founder (uid == familyId)
    // OR any member whose Firestore users/{uid}.familyId points to this family.
    match /families/{familyId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && (request.auth.uid == familyId
            || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
                && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId == familyId));
    }

    // Merchant verification files (civil ID, registration PDFs). The owner
    // writes; the CRM displays them via tokenized download URLs.
    match /merchants/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
