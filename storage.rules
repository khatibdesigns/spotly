rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each family can read/write only its own files (memory photos, etc.).
    match /families/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Merchant verification files (civil ID, registration PDFs). The owner
    // writes; the CRM displays them via tokenized download URLs.
    match /merchants/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
